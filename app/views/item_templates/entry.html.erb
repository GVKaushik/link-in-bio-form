<h1> Add a new item </h1>

<form action="/insert_item" method="post">
<div>
  <label for="link_url_box"> Link URL </label>
  <input id="link_url_box" name="link_url" placeholder="Enter a URL..." type="text">
</div>

<div>
  <label for="link_description_box"> Link Description </label>
  <input id="link_description_box" name="link_desc" placeholder="Enter a link description..." type="text">
</div>

<div>
  <label for="link_thumbnail_box"> Thumbnail URL </label>
  <input id="link_thumbnail_box" name="link_thumbnail" placeholder="Enter a thumbnail URL..." type="text">
</div>

<button> Create item </button>
</form>
